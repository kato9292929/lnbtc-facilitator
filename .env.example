# facilitator/main.py が読む環境変数。値は書かない（秘密情報はコミットしない）。

# リプレイストアの SQLite ファイル（永続ディスク上。古いバックアップで戻さない）
LNBTC_STORE_PATH=
# クレジット台帳の SQLite ファイル（LNBTC_STORE_PATH とは別のファイル）
LNBTC_CREDIT_PATH=
# 鍵ID:秘密,鍵ID:秘密（秘密は 32 文字以上。入れ替え中は 2 本）。1 本も無ければ起動しない
LNBTC_HMAC_KEYS=
# true のときだけ mainnet を受け付ける。既定 false
LNBTC_ALLOW_MAINNET=
# 既定 60。invoice の作成時刻と支払い後の再送の両方に使う 1 つの設定
LNBTC_SKEW_SECONDS=
# 既定 1000。/settle と /invoice の両方で強制する
LNBTC_MAX_SATS_PER_CALL=
# 既定 120 / 60
LNBTC_RATE_LIMIT=
LNBTC_RATE_LIMIT_WINDOW_SECONDS=
# 受信ノードの公開鍵（66 桁・小文字 16 進）。/invoice の照合に使う
LNBTC_PAY_TO=
# 待ち受け。既定 127.0.0.1:8000（前段は Cloudflare Access）
LNBTC_HOST=
LNBTC_PORT=

# Phase 2 で使う。macaroon は invoice 発行と照会に絞ったもの
LND_REST_URL=
LND_MACAROON_PATH=
LND_TLS_CERT_PATH=
